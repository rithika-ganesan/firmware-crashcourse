#!/usr/bin/env bash
set -e

IMAGE="fw-ghdl:latest"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
XHOST=/opt/X11/bin/xhost

# Check that XQuartz is installed
if [ ! -x "$XHOST" ]; then
  echo "XQuartz not found. Install it with: brew install --cask xquartz"
  echo "Then log out and back in, open XQuartz > Settings > Security,"
  echo "and enable 'Allow connections from network clients'."
  exit 1
fi

# Start XQuartz if it isn't running
if ! pgrep -x Xquartz >/dev/null 2>&1; then
  open -a XQuartz
  sleep 3
fi

# Allow the container to connect to the X server
DISPLAY=:0 "$XHOST" +localhost >/dev/null

# Build the image only if it doesn't exist yet
# (assumes the Dockerfile is in the same folder as this script)
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Image not found, building..."
  docker build --platform linux/amd64 -t "$IMAGE" "$SCRIPT_DIR"
fi

docker run --rm -it \
  --platform linux/amd64 \
  -e DISPLAY=host.docker.internal:0 \
  -e LIBGL_ALWAYS_SOFTWARE=1 \
  -v "$(pwd)":/work \
  -w /work \
  "$IMAGE" bash
